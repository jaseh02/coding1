<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Website</title>
<style>
    .signup-button {
        background-color: rgb(25, 206, 22);
        color: white;
        border: none;
        height: 40px;
        width: 105px;
        border-radius: 2px;
        cursor: pointer;
        margin-right: 80px;
        margin-left: 30px;       
    }

    .apply-button{
        background-color: blue;
        border-color: rgb(41, 118, 211);
        border-radius: 20px;
        border-style: solid;
        border-width: -10px;
        color: white;
        height: 40px;
        cursor: pointer;
        margin-right: 40px;
        font-size: 20px;
    
    }

    .get-button {
        background-color: rgb(118, 67, 206);
        color: white;
        border: none;
        height: 45px;
        width: 105px;
        cursor: pointer;
    }

      .download-button {
        background-color: rgb(118, 67, 206);
        color: white;
        border: none;
        height: 45px;
        width: 105px;
        cursor: pointer;
        margin-left: 8px;
        margin-top: 15px;
    }

    .req-button {
        background-color: rgb(118, 67, 206);
        color: white;
        border: none;
        height: 45px;
        width: 105px;
        cursor: pointer;
        margin-left: 30px;
        margin-top: 15px;
    }
</style>

</head>
<body>
    <button class="signup-button">Sign Up</button>
    <button class="apply-button">Apply on company website</button>
    <button class="get-button">Get Started</button>
    <button class="download-button">Download</button>
    <button class="req-button">Request Now</button>
</body>
</html>


